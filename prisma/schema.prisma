generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoCompromisso {
  COMPROMISSO
  PROVA
  TRABALHO
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(255)
  senhaHash String   @map("senha_hash") @db.VarChar(255)
  perfil    String   @default("usuario") @db.VarChar(30)
  criadoEm  DateTime @default(now()) @map("criado_em")

  compromissos Compromisso[]
  estudos      Estudo[]
  tarefas      Tarefa[]

  @@map("usuarios")
}

model Compromisso {
  id         Int             @id @default(autoincrement())
  titulo     String          @db.VarChar(255)
  disciplina String?         @db.VarChar(120)
  descricao  String?         @db.Text
  tipo       TipoCompromisso @default(COMPROMISSO)

  data          DateTime @db.Date
  horarioInicio DateTime @map("horario_inicio") @db.Time(0)
  horarioFim    DateTime @map("horario_fim") @db.Time(0)

  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  estudos Estudo[]

  @@map("compromissos")
}

model Estudo {
  id        Int      @id @default(autoincrement())
  materia   String   @db.VarChar(120)
  inicio    DateTime
  fim       DateTime
  concluido Boolean  @default(false)

  usuarioId     Int  @map("usuario_id")
  compromissoId Int? @map("compromisso_id")

  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  compromisso Compromisso? @relation(fields: [compromissoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, inicio])
  @@map("estudos")
}

model Tarefa {
  id         Int       @id @default(autoincrement())
  titulo     String    @db.VarChar(255)
  descricao  String?   @db.Text
  prazo      DateTime?
  inicio     DateTime?
  fim        DateTime?
  prioridade String    @default("MEDIA") @db.VarChar(20)
  status     String    @default("PENDENTE") @db.VarChar(20)
  criadoEm   DateTime  @default(now()) @map("criado_em")

  usuarioId Int     @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, prazo])
  @@map("tarefas")
}
