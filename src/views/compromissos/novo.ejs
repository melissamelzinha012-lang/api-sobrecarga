<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= typeof compromisso !== 'undefined' && compromisso ? 'Editar compromisso' : 'Novo compromisso' %> | Dayly</title>
    <link rel="icon" type="image/png" href="/images/dayly-icone.png">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f3fa;
            color: #29243a;
        }

        header {
            background: #6687bd;
            color: white;
            padding: 30px;
        }

        main {
            max-width: 700px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 3px 10px #00000010;
        }

        h2 {
            color: #6687bd;
            margin-bottom: 25px;
        }

        .campo {
            margin-bottom: 18px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 15px;
        }

        .botoes {
            display: flex;
            gap: 10px;
            margin-top: 25px;
        }

        .botoes button,
        .botoes a {
            padding: 12px 18px;
            border-radius: 8px;
            border: none;
            text-decoration: none;
            cursor: pointer;
            font-size: 15px;
        }

        button {
            background: #6687bd;
            color: white;
        }

        .botoes a {
            background: #ddd;
            color: #333;
        }
    </style>
</head>

<%
  const editando = typeof compromisso !== 'undefined' && compromisso;
  const valorData = editando ? new Date(compromisso.data).toISOString().slice(0, 10) : '';
  const valorInicio = editando ? new Date(compromisso.horarioInicio).toISOString().slice(11, 16) : '';
  const valorFim = editando ? new Date(compromisso.horarioFim).toISOString().slice(11, 16) : '';
%>
<body class="com-menu">

<div class="dashboard-shell">
    <%- include('../partials/sidebar', { ativo: 'compromissos' }) %>
    <div class="dashboard-content rota-conteudo">


    <header>
        <h1><%= editando ? 'Editar compromisso' : 'Novo compromisso' %></h1>
        <p><%= editando ? 'Atualize os dados do compromisso.' : 'Cadastre um novo compromisso na sua rotina.' %></p>
    </header>

    <main>

        <div class="card">

            <h2><%= editando ? 'Dados do compromisso' : 'Cadastrar compromisso' %></h2>

            <form action="<%= editando ? `/compromissos/${compromisso.id}/editar` : '/compromissos' %>" method="POST">

                <div class="campo">
                    <label for="titulo">Título</label>

                    <input
                        type="text"
                        id="titulo"
                        name="titulo"
                        value="<%= editando ? compromisso.titulo : '' %>"
                        placeholder="Ex.: Aula de Matemática"
                        required
                    >
                </div>

                <div class="campo">
                    <label for="data">Data</label>

                    <input
                        type="date"
                        id="data"
                        name="data"
                        value="<%= valorData %>"
                        required
                    >
                </div>

                <div class="campo">
                    <label for="horarioInicio">Horário inicial</label>

                    <input
                        type="time"
                        id="horarioInicio"
                        name="horarioInicio"
                        value="<%= valorInicio %>"
                        required
                    >
                </div>

                <div class="campo">
                    <label for="horarioFim">Horário final</label>

                    <input
                        type="time"
                        id="horarioFim"
                        name="horarioFim"
                        value="<%= valorFim %>"
                        required
                    >
                </div>


                <div class="botoes">

                    <button type="submit">
                        <%= editando ? 'Salvar alterações' : 'Cadastrar' %>
                    </button>

                    <a href="/compromissos">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </main>
    </div>
</div>

</body>

</html>